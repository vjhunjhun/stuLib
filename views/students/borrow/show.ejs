<% layout("./layouts/boilerplate.ejs") %>
<style>
p{
  word-wrap: break-word;
  overflow-wrap: break-word;
  white-space: normal;
}
.open-book {
  background: #fdf9f3;
  padding: 40px 20px;
  border-radius: 12px;
  box-shadow: 0px 8px 25px rgba(0,0,0,0.15);
  display: flex;
  gap: 20px;
  position: relative;
  max-width: 950px;
  margin: 40px auto;
  flex-wrap: wrap; 
}


.open-book::before {
  content: "";
  width: 3px;
  background: #d1c7b7;
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
}

.book-page {
  flex: 1;
  min-width: 300px;
  background: #ffffff;
  border-radius: 10px;
  padding: 25px 30px;
  box-shadow: inset 0 0 8px rgba(0,0,0,0.08);
}

.page-title {
  font-weight: 700;
  color: #1e3c72;
}

.label {
  font-weight: 600;
  color: #2a5298;
}

@media (max-width: 768px) {
    .open-book {
        margin: 10px;
    padding: 20px 10px;
    gap: 15px;
  }

  .open-book::before {
    display: none;
  }

  .book-page {
    width: 100%;
    min-width: 100%;
    padding: 20px 18px;
  }

  .page-title {
    font-size: 20px;
  }
}
</style>
<div class="container mt-5 mb-5">
  
<a href="/student/borrowed" class="btn btn-outline-secondary btn-sm mb-1">
        <i class="fa-solid fa-arrow-left"></i> Back
      </a>
      
<div class="open-book">

  
  <div class="book-page">
    <h3 class="page-title"><%= book.title %></h3>
    <hr>

    <p><span class="label">Subject:</span> <%= book.subject %></p>
    <p><span class="label">Author:</span> <%= book.author %></p>
    <p><span class="label">Faculty:</span> <%= book.faculty || 'N/A' %></p>
    <p><span class="label">Semester:</span> <%= book.semester || 'N/A' %></p>
    <p class="description"><span class="label">Description:</span><br>
      <%= book.description || "No description available." %>
    </p>
  </div>

  
  <div class="book-page">
    <h4 class="page-title">Book Information</h4>
    <hr>
    <p><span class="label">ISBN:</span> <%= book.isbn ||'N/A'%></p>
    <p><span class="label">Category:</span> <%= book.category ||'N/A'%></p>
    <%if(owner){%>
    <p><span class="label">Owner:</span> <%= owner.username ||'N/A'%></p>
    <%}%>
    <%if(lendDoc){%>
    <p><span class="label">Borrowed On:</span> <%= lendDoc.borrowDate.toLocaleDateString("en-GB") ||'N/A'%></p>
    <%}%>
    <div class="mt-3">
        <button 
  class="btn btn-outline-danger btn-sm confirm-button" 
  data-bs-toggle="modal" 
  data-bs-target="#confirmModal">
  <i class="fa-solid fa-bell"></i> Return Book
    </button>
    </div>
  </div>

</div>


<div class="modal fade" id="confirmModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">Confirm Return</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body text-center">
        Are you sure you want to return this book?
      </div>

      <div class="modal-footer d-flex justify-content-between">
          <a href="/student/borrowed/<%=book._id%>" class="btn btn-secondary" data-bs-dismiss="modal">
            Go Back
        </a>
        <form 
  method="POST"
  action="<%=book._id%>/return?_method=patch">
  <button type="submit" class="btn btn-danger">Return</button>
</form>

      </div>

    </div>
  </div>
</div>
</div>


