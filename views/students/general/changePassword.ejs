<% layout("./layouts/boilerplate.ejs") %>
<div class="container mt-5 mb-5">
   <a href="/student/profile" class="btn btn-outline-secondary btn-sm mb-2">
        <i class="fa-solid fa-arrow-left"></i> Back
      </a>
  <div class="row justify-content-center">
    <div class="col-md-6">

      <div class="card shadow border-0 rounded-4 p-3 p-md-4 p-lg-5">
        <div class="card-body p-2 p-md-3 p-lg-4">

          <h4 class="text-center mb-4">Change Password</h4>

          <form
            action="/student/profile/change-password?_method=patch"
            method="POST"
            class="needs-validation"
            novalidate
          >
            <div class="mb-3">
              <label for="newPassword" class="form-label">
                Old Password
              </label>

              <input
                type="password"
                class="form-control"
                id="oldPassword"
                name="oldPassword"
                required
                minlength="4"
              />

              <div class="invalid-feedback">
                Password must be at least 4 characters long.
              </div>
            </div>
            <div class="mb-3">
              <label for="newPassword" class="form-label">
                New Password
              </label>

              <input
                type="password"
                class="form-control"
                id="newPassword"
                name="newPassword"
                required
                minlength="4"
              />

              <div class="invalid-feedback">
                Password must be at least 4 characters long.
              </div>
            </div>

            <div class="d-grid">
              <button class="btn btn-primary">
                Change Password
              </button>
            </div>

          </form>

        </div>
      </div>

    </div>
  </div>
</div>
