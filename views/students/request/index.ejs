<%layout("/layouts/boilerplate.ejs")%>
<style>
    span i{
        font-size: 3rem;
    }
</style>
<div class="container mt-5 mb-5">
    <a href="/student/" class="btn btn-outline-secondary btn-sm mb-1">
        <i class="fa-solid fa-arrow-left"></i> Back
      </a>
    <div class="row text-center mt-5 justify-content-center">    
        <div class="col-lg-3 col-md-6 col-sm-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column justify-content-center">
                    <h5 class="card-title">Sent Requests</h5>
                    <p class="card-text">Request which you have send.</p>
                    <span><i class="fa-solid fa-paper-plane"></i></span>
                    <a href="/student/requests/sent" class="btn btn-outline-primary mt-auto">See Now.</a>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 col-sm-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column justify-content-center">
                    <h5 class="card-title">Received Requests</h5>
                    <p class="card-text">Request which you have received.</p>
                    <span><i class="fa-solid fa-inbox"></i></span>
                    <a href="/student/requests/received" class="btn btn-outline-secondary mt-auto">See Now.</a>
                </div>
            </div>
        </div>

    </div>
</div>
